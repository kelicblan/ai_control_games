{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:campmind:native-ts-bridge:1",
  "title": "Opt-in native TS bridge v1; not the future C# authority save format",
  "oneOf": [{"$ref":"#/$defs/snapshot"},{"$ref":"#/$defs/request"}],
  "$defs": {
    "revision":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "snapshot":{
      "type":"object","required":["schemaVersion","revision","state"],
      "properties":{
        "schemaVersion":{"const":1},"revision":{"$ref":"#/$defs/revision"},
        "state":{"type":["object","null"]},"dialogueScope":{"type":"string","pattern":"^[^:]+:[^:]+$"},
        "speed":{"type":"number","exclusiveMinimum":0},"savedAt":{"type":"number","minimum":0},
        "recovered":{"type":"boolean"},"temporaryPause":{"type":"boolean"},"catchingUp":{"type":"boolean"}
      },
      "if":{"properties":{"state":{"type":"object"}}},"then":{"required":["dialogueScope"]},
      "additionalProperties":true
    },
    "request":{
      "type":"object","required":["revision","operation","action"],
      "properties":{
        "revision":{"$ref":"#/$defs/revision"},"operation":{"type":"string","pattern":"^[a-zA-Z0-9-]{1,64}$"},
        "action":{"type":"object","required":["type"],"properties":{"type":{"enum":["start","reset","import","command","pause","speed","agency-model","agency-settings","social-choice","social-refresh","dialogue-result","caption"]}},"additionalProperties":true}
      },"additionalProperties":false
    }
  }
}
