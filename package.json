{
  "name": "campmind-survival",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "pwsh -NoProfile -File scripts/unity/play.ps1",
    "world": "node --import tsx scripts/world/server.ts",
    "npc:setup": "node scripts/prepare-minimind.mjs --download",
    "build": "pwsh -NoProfile -File scripts/unity/build-game.ps1",
    "test": "vitest run",
    "test:migration": "vitest run tests/unity-fixture-export.test.ts tests/unity-save-backup.test.ts tests/unity-asset-inventory.test.ts tests/unity-tooling.test.ts tests/unity-scene-export.test.ts tests/unity-wire-protocol.test.ts tests/unity-wire-server.test.ts tests/unity-render-replay.test.ts --maxWorkers=1 --minWorkers=1 && node --test tests/unity-process-lifecycle.test.mjs tests/unity-lod.test.mjs",
    "check:npc": "tsc -p packages/npc-core/tsconfig.json && tsc -p packages/npc-dialogue/tsconfig.json && tsc -p packages/npc-settings/tsconfig.json && node scripts/check-npc-boundaries.mjs",
    "test:watch": "vitest",
    "train": "python scripts/train_policy.py",
    "evaluate": "node --import tsx scripts/evaluate.ts",
    "evaluate:survival": "node --import tsx scripts/evaluate-survival.ts",
    "check": "tsc --noEmit",
    "village:import": "python scripts/village/import_xlsx.py config/village/source.xlsx --output src/games/camp/village/config",
    "village:compile": "node --import tsx scripts/village/compile-rules.ts",
    "check:village": "tsc -p tsconfig.village.json",
    "village:simulate": "node --import tsx scripts/village/simulate.ts collect",
    "village:collect": "node --import tsx scripts/village/simulate.ts collect",
    "village:replay": "node --import tsx scripts/village/simulate.ts replay",
    "village:collect:life": "node --import tsx scripts/village/collect-life-alpha.ts",
    "train:v4:life": "python scripts/mlp_v4/train.py data/village/life-alpha/dataset.json native/Artifacts/village/P2/retrain-life-alpha",
    "village:evaluate:life": "node --import tsx scripts/village/evaluate-life-alpha.ts",
    "village:collect:v4": "node --import tsx scripts/village/collect.ts",
    "village:corrections": "node --import tsx scripts/village/collect-corrections.ts",
    "village:parity": "node --import tsx scripts/village/verify-v4-parity.ts",
    "village:evaluate:v4": "node --import tsx scripts/village/evaluate-v4.ts",
    "village:benchmark": "node --import tsx scripts/village/benchmark.ts",
    "village:package": "node scripts/village/package.mjs",
    "village:build": "pwsh -NoProfile -File scripts/unity/build-village.ps1"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0",
    "three": "^0.186.1"
  }
}
