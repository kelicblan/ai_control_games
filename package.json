{
  "name": "campmind-survival",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "npc:setup": "node scripts/prepare-minimind.mjs --download",
    "predev": "node scripts/prepare-minimind.mjs",
    "prebuild": "node scripts/prepare-minimind.mjs",
    "build": "tsc -b && vite build && node scripts/generate-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "check:npc": "tsc -p packages/npc-core/tsconfig.json && tsc -p packages/npc-dialogue/tsconfig.json && node scripts/check-npc-boundaries.mjs",
    "test:watch": "vitest",
    "train": "python scripts/train_policy.py",
    "evaluate": "node --import tsx scripts/evaluate.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@wllama/wllama": "3.8.1",
    "@wllama/wllama-compat": "3.8.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
